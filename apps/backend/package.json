{
  "name": "@bbw/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --watch ../../packages/interfaces/src --ext ts --exec 'tsx --env-file=.env.local src/index.ts'",
    "test": "vitest run --config vitest.canonical.config.ts",
    "test:legacy": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "catalog:import": "tsx --env-file=.env.local scripts/import-catalog-treatments.ts"
  },
  "dependencies": {
    "@bbw/interfaces": "*",
    "@marketto/codice-fiscale-utils": "^3.1.3",
    "@pallari/italian-address-client": "^1.2.3",
    "@supabase/supabase-js": "^2.103.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "ibantools": "^4.5.4",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "node-mailjet": "^6.0.11",
    "rate-limiter-flexible": "^11.2.0",
    "ws": "^8.21.0",
    "zod": "^4.3.6",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.5",
    "@types/supertest": "^7.2.0",
    "@types/ws": "8.18.1",
    "@types/zxcvbn": "^4.4.5",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.16"
  }
}
